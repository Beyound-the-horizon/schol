# ==============================================================================
# Scholarship Platform Backend Configuration
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (Supabase Cloud PostgreSQL or Local / Test)
# For Supabase Cloud PostgreSQL, use the Direct or Transaction Pooler connection string:
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# For offline local testing without PostgreSQL, SQLite can be used: sqlite+aiosqlite:///./scholarships_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Database Pool Settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Crawler Ingestion Authentication Token
# Shared secret required in the X-Ingestion-Token header for POST /api/v1/scholarships/ingest
INGESTION_TOKEN=dev-secret-ingestion-token-change-me
