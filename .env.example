# ==============================================================================
# Scholarship Platform Configuration
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (Supabase Cloud PostgreSQL or Local / Test)
# For Supabase Cloud PostgreSQL, use the Direct or Transaction Pooler connection string:
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# For offline local testing without PostgreSQL, SQLite can be used: sqlite+aiosqlite:///./scholarships_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Database Pool Settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Crawler Ingestion Authentication Token
# Shared secret required in the X-Ingestion-Token header for POST /api/v1/scholarships/ingest
INGESTION_TOKEN=dev-secret-ingestion-token-change-me

# Admin Editorial & Publication Authentication Token
# Shared secret required in the X-Admin-Token or Authorization: Bearer <token> for administrative review
ADMIN_TOKEN=dev-secret-admin-token-change-me

# Frontend Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# ==============================================================================
# Supabase Frontend Configuration
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Autonomous Crawler Configuration
# ==============================================================================
# API URL of the backend ingestion service (defaults to http://127.0.0.1:8000/api/v1)
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google Gemini API key for researcher & structurer agent LLM execution
# Obtain from https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API=
# GEMINI_API_KEY=

# Tavily Search API key (optional, used for search testing)
TAVILY_API_KEY=

# Google Docs URL containing the curated catalog of scholarship targets
SCHOLARSHIP_CATALOG_URL=https://docs.google.com/document/d/1example/export?format=txt

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://schol-tau.vercel.app/
SESSION_SECRET=70b055014fed23a2c19cc1d173ce802725fd03cb2d1d2f1c4b53af69c853e5c5